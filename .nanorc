set tabsize 4
set tabstospaces

# nano grabs the mouse, so tmux (mouse_any_flag set) forwards clicks and wheel
# to it instead of entering copy-mode. Shift+drag still selects text natively.
set mouse

# ponytail: Ghostty sends Alt+Left/Right as ESC b / ESC f (readline word-move
# convention), not arrow-key sequences, so M-Left/M-Right never matched.
bind M-B prevword all
bind M-F nextword all

# ponytail: no native "move line" function in nano; macro emulates it via
# cut+move+paste. Cursor column resets to 0 on the moved line; edge cases at
# buffer start/end may behave oddly. Real fix if that matters: a nano patch.
# Shift+Alt+U / Shift+Alt+D keep Alt+Up/Down as scrollup/scrolldown here;
# ~/.nanorc.darwin rebinds Alt+Up/Down to these macros on macOS.
bind Sh-M-U "{cut}{up}{paste}{up}" main
bind Sh-M-D "{cut}{down}{paste}{up}" main

## Syntax highlighting for the Ghostty terminal config file.
syntax ghostty "(^|/)config\.ghostty$"
comment "#"

color cyan "#.*"
color brightcyan "^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*="
color brightgreen "\<(true|false)\>"
color brightmagenta "#[0-9A-Fa-f]{3,8}\>"
color brightyellow "\<[0-9]+(\.[0-9]+)?\>"
