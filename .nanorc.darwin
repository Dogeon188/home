# macOS-only binds, merged after ~/.nanorc by the shell rc (see EDITOR there).
# Option+Up/Down move the line, overriding the default scrollup/scrolldown.
bind M-Up "{cut}{up}{paste}{up}" main
bind M-Down "{cut}{down}{paste}{up}" main

# Ghostty sends Cmd+Backspace as ^U (readline kill-line), which nano binds to
# paste. Make it delete the line instead, without touching the cut buffer.
bind ^U zap main
